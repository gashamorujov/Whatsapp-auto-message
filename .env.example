# ──────────────────────────────────────────────────────────────
# İST Services Dənizcilik Təlim Mərkəzi — Avtomatik Sorğu Botu
# environment dəyişənləri (nümunə — TAMAMLAŞ İSTEĞEYƏ BAĞLIDIR)
#
# ⚠️  BU FAYL LAZIM DEYİL!
#     Bot bütün konfiqurasiyanı `config.js` faylından oxuyur və
#     .env olmadan da tam işləyir:
#        node bot.js
#
#     Bu faylı yalnız mühit dəyişənləri ilə override etmək istəyirsinizsə
#     kopyalayın:  cp .env.example .env
#     (ətraf mühit dəyişənləri .env-dən ÜSTÜNDÜR)
#
# Real token/parollar repoya YAZMAYIN.
# ──────────────────────────────────────────────────────────────

# Telegram bot tokeni — @BotFather-dan.
# Defolt: config.js faylında saxlanılır (tövsiyə olunan).
# Alternativ: TELEGRAM_TOKEN=... (bu halda config.js-ə üstündür)
TELEGRAM_TOKEN=

# Giriş nəzarəti — İSTƏYƏ BAĞLI.
# Boş buraxın: botda ilk şəxsi çatda yazan istifadəçi avtomatik sahib olur
# (data/owner.json-da saxlanılır, restartdan sonra qalır).
# Sıfırlamaq üçün həmin faylı silin.
ALLOWED_TELEGRAM_IDS=
# Hər kəsə açıq bot (TÖVSİYƏ OLUNMUR)
ALLOW_ALL_USERS=false

# PORT platforma tərəfindən avtomatik verilir; lokal default 3000.
# İlk açılışda qoşulacaq WhatsApp nömrəsi (ölkə kodu ilə, + olmadan)
PAIR_NUMBER=

# Daimi məlumat qovluğu (Railway/Docker volume üçün):
# owner.json, sheets.json, blocked.json, snapshot/
BOT_DATA_DIR=

# ── Cədvəllər ──
# Yeniləmə tezliyi (dəqiqə). 60 = saatda bir dəfə.
SHEET_REFRESH_MINUTES=60

# Kurs adının mənbəyi:
#   map   (defolt) = kod→ad xəritəsi (modules/courseCodes.js)
#   sheet            = cədvəldəki "Kursun adı" sütunu
COURSE_NAME_SOURCE=map

# Default cədvəl linkləri (Telegram-dan dəyişdirilə bilər)
SHEET_CERT_URL=https://docs.google.com/spreadsheets/d/14A3Utt4RZLy2uP0XSFL_gsEJf8a2k_4P/edit?gid=1252670317#gid=1252670317
SHEET_COURSE_URL=https://docs.google.com/spreadsheets/d/19Ggn9KY6a8a1PaU0vdCOTakmkYounGqt/edit?gid=803500785#gid=803500785

# ── Bot davranışı ──
# Avtomatik cavab (sertifikat / kurs yoxlaması)
WA_AUTO_REPLY=true
# Yalnız fərdi (şəxsi) chat-lərdə cavab — qruplarda bot susar
WA_PRIVATE_ONLY=true
# Gələn WhatsApp mesajlarını Telegram-a ötür (monitorinq)
TG_FORWARD_INCOMING=true
# Anti-spam: bir nömrədən bu qədər mesaj / bu qədər dəqiqə
WA_RATE_LIMIT_PER_MIN=8
WA_RATE_LIMIT_WINDOW_MIN=5

# ── Digər ──
REPORT_TIMEZONE=Asia/Baku
TEMP_FILE_MAX_AGE_MIN=120
TG_MAX_DOWNLOAD_MB=50

# ── Loglar ──
# text (default) və ya json (strukturlu)
LOG_FORMAT=text
# Loglarda telefon nömrələrini maskala (tövsiyə: true)
LOG_REDACT_PHONES=true
